PORT=8787
MANAGER_PORT=8790
HOST=0.0.0.0
TAILSCALE_ONLY=true
REPO_PATH=/home/ubuntu/work/repos/Pilot
CLAUDE_TMUX_SESSION=claude
CODEX_TMUX_SESSION=codex

# Required for write actions (input, create/kill session, AI ask) from non-localhost clients.
AGENT_OPS_TOKEN=replace-with-a-random-token-for-write-hooks

# Slack alerting and Devy mention triage (either webhook OR bot token; bot enables Socket Mode).
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# User token authorized by the watched user. Required for workspace/user message events and
# context reads without inviting the Devy bot to every channel.
SLACK_USER_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SOCKET_MODE=false

# Legacy tmux/hook alerts posted to SLACK_CHANNEL_ID (waiting-for-input,
# approval_required, error). Set false to stop channel alert spam; events are
# still recorded and visible on the dashboard. Devy triage reports are separate
# and unaffected.
ENABLE_AGENT_ALERTS=true

# Bolt log level: info (default), debug, warn, error. debug writes full Slack
# payloads, including message text, to the journal — enable only while debugging.
SLACK_LOG_LEVEL=info

# Devy acts only on an explicit <@SLACK_WATCH_USER_ID> mention or a DM to Devy.
# SLACK_WATCH_NAMES is opt-in: listing bare names (e.g. mukil) also triages
# messages that merely say the name, which is a much wider net. Empty = off.
SLACK_WATCH_USER_ID=
SLACK_WATCH_NAMES=

# Optional channel allowlist. Empty = every channel your Slack subscriptions
# deliver. Set channel IDs to confine Devy to those channels; DMs to Devy still
# work regardless.
SLACK_OBSERVE_CHANNELS=

SLACK_TRIAGE_CHANNEL_ID=
SLACK_CONTEXT_MESSAGES=12

# Conversational agent: DM Devy or @Devy in a thread and it answers like an
# agent, read-only, with the last N turns of that conversation as context.
SLACK_CHAT_HISTORY_TURNS=20
SLACK_CHAT_TIMEOUT_SECONDS=300

# Unacknowledged reports are re-pinged in their thread on this cadence until you
# acknowledge them. Acknowledging happens via the Acknowledge button, an "ack"
# reply, an approve/reject decision, or any reply in the report thread.
SLACK_ACK_REMINDER_MINUTES=30
SLACK_TRIAGE_TIMEOUT_SECONDS=600
SLACK_BUILD_TIMEOUT_SECONDS=3600
SLACK_CODEX_MODEL=
DEVY_REPOSITORIES=Pilot=/home/ubuntu/work/repos/Pilot,Crucible=/home/ubuntu/work/repos/Crucible

# Browser-to-tmux input + new session creation.
# Enabled unless explicitly set to false. Writes still require AGENT_OPS_TOKEN
# from non-localhost clients, so leaving this on is safe behind Tailscale.
ENABLE_AGENT_INPUT=true

# tmux fallback alert threshold.
AGENT_WAIT_ALERT_SECONDS=30

# AI assistant / agent. Pick a provider by setting its API key. If OPENAI_API_KEY
# is present the agent uses OpenAI; otherwise it uses Anthropic. Force a specific
# one with AGENT_OPS_AI_PROVIDER=openai|anthropic.
AGENT_OPS_AI_PROVIDER=

# OpenAI (ChatGPT) — the default when this key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Anthropic (Claude) — used when no OpenAI key is set.
ANTHROPIC_API_KEY=
AGENT_OPS_AI_MODEL=claude-opus-4-8

# Agentic AI: lets the in-browser assistant run bash, read/write files, search
# the web, and drive the other tmux agents. Enabled unless set to false. Runs as
# the ubuntu user behind Tailscale + write-auth. Set false for a read-only chat.
ENABLE_AGENT_TOOLS=true
AGENT_BASH_TIMEOUT_SECONDS=180
# The bash tool refuses a small set of machine-bricking commands (rm -rf / or ~,
# mkfs, dd or > to a raw disk, fork bombs, shutdown/reboot). Set true to drop even
# that guard. Leave false unless you trust every client that holds AGENT_OPS_TOKEN.
AGENT_UNRESTRICTED_BASH=false

# Opt-in integration tests (npm test). Both call real services, so they are
# skipped unless set to 1: a live Codex run, and Slack's blocks.validate API.
DEVY_RUN_CODEX_SMOKE=
DEVY_VALIDATE_SLACK_BLOCKS=
